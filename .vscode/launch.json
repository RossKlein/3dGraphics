{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Graphicsv3 (Main + build native)",
      "request": "launch",
      "mainClass": "Ross.Instance.Main",
      "cwd": "${workspaceFolder}",
      "vmArgs": "-Djava.library.path=${workspaceFolder}/natives -Xmx1g -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=8",
      "preLaunchTask": "build-native-windows"
    },
    {
      "type": "java",
      "name": "Graphicsv3 (Main, Java only)",
      "request": "launch",
      "mainClass": "Ross.Instance.Main",
      "cwd": "${workspaceFolder}",
      "vmArgs": "-Djava.library.path=${workspaceFolder}/natives -Xmx1g -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=8"
    }
  ]
}
